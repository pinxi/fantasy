# Sleeper internal GraphQL JWT (grab from DevTools: Authorization header on sleeper.com/graphql requests).
# Expires ~Aug 2027; rotates if the Sleeper password changes.
SLEEPER_JWT=

# FantasyPros subscriber API key (https://www.fantasypros.com/apis/)
FANTASYPROS_API_KEY=

# Discord webhook for alerts (later milestone)
DISCORD_WEBHOOK_URL=

# Where the SQLite db + raw snapshot archive live (default ./data)
DATA_DIR=./data

TZ=America/New_York
